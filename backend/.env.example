# ============================================================
# HuellAPP - Backend
# Archivo de ejemplo de variables de entorno.
#
# Este archivo documenta las variables necesarias para ejecutar
# el backend, pero NO contiene credenciales reales.
#
# SECURITY:
# - Sí se puede versionar en Git.
# - Nunca reemplazar estos valores con secretos reales.
# - Las credenciales reales deben almacenarse únicamente en ".env"
#   o en el gestor de variables del proveedor de despliegue.
# ============================================================


# ============================================================
# APLICACIÓN
# ============================================================

APP_NAME=HuellAPP API

# Valores esperados:
# development
# production
APP_ENV=development


# ============================================================
# FRONTEND
# ============================================================

# URL base del frontend correspondiente al ambiente actual.
#
# Local:
# http://localhost:5173
#
# DEV / QA:
# https://huellapp-frontend-git-develop-huell-app.vercel.app
#
# PROD:
# https://huellapp-frontend.vercel.app
#
# Esta URL se utiliza, entre otras cosas, para construir
# redirects de invitaciones y flujos de autenticación.
FRONTEND_URL=http://localhost:5173


# ============================================================
# SUPABASE
# ============================================================

# URL del proyecto Supabase.
SUPABASE_URL=

# Clave secreta exclusiva del backend.
#
# SECURITY:
# - Nunca usar esta clave en React.
# - Nunca incluirla en VITE_*.
# - Nunca subirla al repositorio.
SUPABASE_SECRET_KEY=


# ============================================================
# CORS
# ============================================================

# Pydantic Settings interpreta listas desde variables de entorno
# utilizando JSON válido.
#
# Local:
# ["http://localhost:5173"]
#
# DEV / QA:
# ["https://huellapp-frontend-git-develop-huell-app.vercel.app"]
#
# Si un backend atiende temporalmente ambos ambientes:
# [
#   "http://localhost:5173",
#   "https://huellapp-frontend-git-develop-huell-app.vercel.app"
# ]
#
# En una sola línea:
CORS_ORIGINS=["http://localhost:5173"]