# ============================================================
# HuellAPP - Backend
# Archivo de ejemplo de variables de entorno.
#
# Este archivo documenta las variables necesarias para ejecutar
# el backend, pero NO contiene credenciales reales.
#
# SECURITY:
# - Sí se puede versionar en Git.
# - Nunca reemplazar estos valores con secretos reales.
# - Las credenciales reales deben estar solamente en ".env".
# ============================================================

APP_NAME=HuellAPP API
APP_ENV=development

SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Pydantic Settings interpreta listas desde variables de entorno
# utilizando JSON válido.
CORS_ORIGINS=["http://localhost:5173"]
